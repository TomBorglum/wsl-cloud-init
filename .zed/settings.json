// Project settings for Zed, carrying only what stops the editor reformatting this repo's
// files away from how they are written.
//
// Zed formats YAML, JSON and Markdown with its bundled Prettier, whose tabWidth, printWidth
// and useTabs follow Zed's tab_size, preferred_line_length and hard_tabs unless set in a
// "prettier" object. Those default to 4 and 80, so an unconfigured Zed re-indents this
// repo's 2-space YAML to 4 and breaks lines it should leave alone.
//
// Not set on purpose:
//   format_on_save - left to user settings, so formatting stays manual.
//   formatter      - "auto" already picks Prettier for every language here, and with no
//                    Markdown language server installed, disallowing Prettier for Markdown
//                    below leaves it nothing to find.
{
  // This repo is 2-space indented throughout, and these two are the documented source for
  // Prettier's tabWidth and printWidth.
  //
  // 100 rather than 80 because every workflow pins its actions by SHA, and
  // `- uses: <action>@<40-char-sha> # <version>` reaches 96 characters. 100 also keeps the
  // compact `{ "type": ..., "section": ... }` entries in release-please-config.json on one
  // line each; the longest is 82 characters, so Prettier at 80 would explode every one of
  // them onto four lines.
  "tab_size": 2,
  "preferred_line_length": 100,

  "languages": {
    // Pinned again here, not just derived from the two settings above, because a
    // language-specific value REPLACES the top-level one entirely rather than merging with
    // it. Should Zed ever ship a YAML tab_size default, the derivation above stops reaching
    // YAML; this does not.
    //
    // singleQuote is already Prettier's default, stated so the repo's quote style cannot
    // move with a future one. Consequence: `cron: '0 6 * * 1'` in update-lazydocker.yml
    // becomes `cron: "0 6 * * 1"` the next time that file is formatted.
    "YAML": {
      "prettier": {
        "allowed": true,
        "tabWidth": 2,
        "printWidth": 100,
        "singleQuote": false
      }
    },

    // Markdown is turned off rather than widened: the prose here is hand-wrapped and runs
    // past 300 columns in places, so there is no printWidth that makes Prettier a no-op.
    //
    // JSON gets no entry of its own, so Prettier handles it at the width above. One known
    // consequence: it collapses any array that fits inside printWidth, with no option to
    // keep one expanded, so the "deny" list in wsl/user/.claude/settings.json becomes a
    // single 83-character line the first time that file is formatted. Preserving it would
    // need printWidth <= 82, the exact minimum release-please-config.json needs, so the two
    // constraints leave no slack either way.
    "Markdown": {
      "prettier": {
        "allowed": false
      }
    }
  }
}
