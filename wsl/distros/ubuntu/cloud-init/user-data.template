#cloud-config
locale: en_US.UTF-8
# WSL manages its own ext4.vhdx sizing, so the rootfs resize is a no-op here. It also
# fails on older LTS images (22.04's resize2fs 1.46.5 rejects newer ext4 features),
# which flips cloud-init status to error. Disable the module.
resize_rootfs: false
users:
  - name: __TARGET_USER__
    groups: [adm, dialout, cdrom, sudo, audio, dip, video, plugdev, netdev, docker]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/zsh
write_files:
  - path: /home/__TARGET_USER__/.config/ubuntu-insights/linux-consent.toml
    content: |
      consent_state = false
    owner: __TARGET_USER__:__TARGET_USER__
    defer: true
  - path: /home/__TARGET_USER__/.config/ubuntu-insights/wsl_setup-consent.toml
    content: |
      consent_state = false
    owner: __TARGET_USER__:__TARGET_USER__
    defer: true
  - path: /home/__TARGET_USER__/.config/ubuntu-insights/ubuntu_release_upgrader-consent.toml
    content: |
      consent_state = false
    owner: __TARGET_USER__:__TARGET_USER__
    defer: true
  - path: /etc/wsl.conf
    content: |
      [boot]
      systemd=true
      [user]
      default=__TARGET_USER__
      [interop]
      appendWindowsPath=false
  - path: /home/__TARGET_USER__/.zshrc
    owner: __TARGET_USER__:__TARGET_USER__
    defer: true
    content: |
      export ZSH="$HOME/.oh-my-zsh"
      ZSH_THEME="robbyrussell"
      plugins=(git z sudo docker zsh-autosuggestions pj)
      source $ZSH/oh-my-zsh.sh

      bindkey "\e[1;2D" backward-char   # Shift+Left
      bindkey "\e[1;2C" forward-char    # Shift+Right

      eval "$(direnv hook zsh)"

      [[ -d ~/projects ]] || mkdir -p ~/projects
      export PROJECT_PATHS=(~/projects)
      # Must run after `source $ZSH/oh-my-zsh.sh` above: these files can redefine
      # plugin functions/completions (e.g. _pj), and the later definition wins.
      for f in /usr/local/share/zsh/site-functions/*.zsh(N); do source "$f"; done

      # WSL starts a shell in the Windows directory it was launched from, which lands
      # under /mnt. Move to $HOME in that case only, so a shell deliberately started in
      # a Linux directory (a Zed terminal or task, `wsl --cd ...`) stays where it was put.
      [[ $PWD != /mnt/* ]] || cd ~
package_update: true
package_upgrade: __PACKAGE_UPGRADE__
packages:
  - git
  - curl
  - build-essential
  - unzip
  - zip
  - zsh
  - gh
  - jq
runcmd:
  # Before anything else runs: write_files/defer sets ownership per file, leaving any parent
  # directory cloud-init created owned by root, and install.sh appends to .zshenv as the user.
  - chown -R __TARGET_USER__:__TARGET_USER__ /home/__TARGET_USER__
  - GIT_TERMINAL_PROMPT=0 git clone --filter=blob:none --sparse https://github.com/TomBorglum/wsl-cloud-init.git /opt/wsl-cloud-init
  # The only place that declares which paths the /opt checkout materializes. install.sh and the
  # numbered install scripts assume every path they consume is already present here and add none
  # of their own. The distros branch is narrowed to `scripts` so the sibling `cloud-init/` stays
  # out; provision.ps1 renders user-data.template Windows-side and never reads it from here.
  #
  # --no-cone because cone mode always materializes every file at the repo root: /opt would carry
  # README.md, CHANGELOG.md and friends, and a root .envrc would fire direnv on every visit.
  # Runs before `checkout __COMMIT__` so the working tree materializes at the pinned commit.
  - git -C /opt/wsl-cloud-init sparse-checkout set --no-cone '/wsl/system/' '/wsl/user/' '/wsl/distros/ubuntu/scripts/' '/wsl/distros/ubuntu/install.sh' '/windows/lib/'
  - git -C /opt/wsl-cloud-init checkout __COMMIT__
  - |
    export TARGET_USER="__TARGET_USER__"
    export WSL_CLOUD_INIT_REF="__REF__"
    export WSL_CLOUD_INIT_INSTANCE_NAME="__INSTANCE_NAME__"
    export INSTALL_CLAUDE_CODE="__INSTALL_CLAUDE_CODE__"
    export INSTALL_GIT_CONFIG="__INSTALL_GIT_CONFIG__"
    export INSTALL_VS_CODE_INTEROP="__INSTALL_VS_CODE_INTEROP__"
    export INSTALL_ZED_INTEROP="__INSTALL_ZED_INTEROP__"
    bash /opt/wsl-cloud-init/wsl/distros/ubuntu/install.sh
