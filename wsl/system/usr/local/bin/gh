#!/bin/bash
# gh wrapper: authenticates gh from the Windows "git:https://github.com" credential that Git
# Credential Manager stores on Windows sign-in. No token is provisioned. Installed ahead of the
# apt-provided /usr/bin/gh on PATH so it wraps every gh invocation.
#
# The credential read goes through wsl_interop_credential in
# /usr/local/lib/wsl-cloud-init/, the durable, git-free bundle the install scripts use, which is
# what lets this wrapper self-heal after a token rotation without the /opt checkout.
#
# gh cannot make Git Credential Manager re-prompt — only a git HTTPS operation refreshes the
# stored credential after a rotation. The wrapper signs in with whatever token Windows currently
# holds; if that is missing or stale it says so, rather than leaving gh's misleading "run
# gh auth login".
#
# No `set -e`: failures are handled explicitly below and $? must survive capture.

source /usr/local/lib/wsl-cloud-init/wsl-interop.sh

GH=/usr/bin/gh
# $POWERSHELL is inherited from the environment (exported from ~/.zshenv, derived once in
# install.sh); wsl_interop_credential and the -x guard below both rely on it. Windows PATH
# isn't on the WSL PATH (wsl.conf appendWindowsPath=false), so the full path is required.

# Read git:https://github.com from Windows and sign gh in; returns non-zero on failure with a
# one-line reason. The wording covers both first use and a re-auth after a token rotation.
__gh_authenticate() {
  echo "" >&2
  echo "Authenticating with the GitHub token from your Windows Git credential..." >&2

  if [[ ! -x "$POWERSHELL" ]]; then
    echo "gh: authentication failed — Windows powershell.exe not found at $POWERSHELL." >&2
    return 1
  fi

  # The helper's own error output is silenced so only the messages below surface.
  local token
  token="$(wsl_interop_credential "git:https://github.com" 2>/dev/null)"
  if [[ -z "$token" ]]; then
    echo "gh: authentication failed — no 'git:https://github.com' credential in Windows Credential Manager." >&2
    return 1
  fi
  if ! "$GH" auth login --with-token <<< "$token" >/dev/null 2>&1; then
    echo "gh: authentication failed — the GitHub token stored in Windows was rejected (likely stale)." >&2
    return 1
  fi
}

# Auth check: a real authenticated request. Reliable across gh versions — unlike
# `gh auth status`, whose exit code can be 0 (gh 2.45) even when the token is invalid.
# Used to tell an auth failure (needs sign-in) apart from any other command failure.
__gh_authed() { "$GH" api user >/dev/null 2>&1; }

# Help and version are local and can't be auth failures — run them directly.
[[ $# -eq 0 ]] && exec "$GH"
case "$1" in
  --version|-v|version|--help|-h|help) exec "$GH" "$@" ;;
esac
for arg in "$@"; do
  case "$arg" in --help|-h) exec "$GH" "$@" ;; esac
done

# Piped stdin: a retry can't re-read a drained pipe, so verify auth up front (signing
# in if needed) and run exactly once.
if [[ ! -t 0 ]]; then
  __gh_authed || __gh_authenticate
  exec "$GH" "$@"
fi

# Interactive / no stdin: run directly, then authenticate and retry once if it failed only
# because gh is not authenticated. Any other failure passes straight through.
"$GH" "$@"
ret=$?
(( ret == 0 )) && exit 0
__gh_authed && exit $ret
__gh_authenticate && exec "$GH" "$@"
exit $ret
