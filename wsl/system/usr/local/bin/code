#!/bin/bash
# code wrapper: opens files and folders in the Windows VS Code editor from inside WSL. The
# launcher is resolved through wsl_interop_vscode_path, which reads $POWERSHELL from the environment.
#
# ConvertTo-WslPath returns the /mnt path with backslash-escaped spaces, since a Windows
# username may contain them, so the launcher goes through `eval`: that re-parses the escape
# into a single argv[0], where an unquoted expansion would word-split on the space.
set -euo pipefail

source /usr/local/lib/wsl-cloud-init/wsl-interop.sh

launcher="$(wsl_interop_vscode_path)"   # set -e exits here if resolution fails
eval "$launcher" '"$@"'
