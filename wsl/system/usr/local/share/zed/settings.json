{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": false
  },
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "jupyter": {
    "enabled": false
  },
  "languages": {
    "YAML": {
      "prettier": {
        "allowed": true,
        "tabWidth": 2,
        "printWidth": 100,
        "singleQuote": false
      }
    }
  },
  "base_keymap": "JetBrains",
  "icon_theme": "Zed (Default)",
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 13,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  }
}
